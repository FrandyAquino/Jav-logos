{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavLogos",
  "version": "0.1.0",
  "identifier": "com.javcollections.javlogos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "dragDropEnabled": false,
      "title": "JavLogos",
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "trafficLightPosition": {"x":20,"y":24},
      "width": 1440,
      "height": 940,
      "minWidth": 900,
      "minHeight": 640
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "A local-first brand identity studio",
    "resources": {
      "../workers/worker.py": "workers/worker.py",
      "../workers/common.py": "workers/common.py",
      "../workers/progress.py": "workers/progress.py",
      "../workers/sdcpp.py": "workers/sdcpp.py",
      "../workers/comfyui_adapter.py": "workers/comfyui_adapter.py",
      "../workers/diffusers_adapter.py": "workers/diffusers_adapter.py",
      "../workers/requirements.txt": "workers/requirements.txt"
    },
    "icon": ["icons/icon.png"]
  }
}
